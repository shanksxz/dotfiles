[
  // ============================================================================
  // NORMAL & VISUAL MODE BINDINGS
  // Common operations active when not in insert mode
  // ============================================================================
  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual) && !VimWaiting && !menu",
    "bindings": {
      // --- Toggles & UI ---
      "space u h": "editor::ToggleInlayHints", // LazyVim: <leader>uh
      "space u w": "editor::ToggleSoftWrap", // LazyVim: <leader>uw
      "space u z": "workspace::ToggleCenteredLayout", // FIX: was space c z. LazyVim: <leader>uz

      // --- Markdown ---
      "space m p": "markdown::OpenPreview", // Open preview in current tab
      "space m P": "markdown::OpenPreviewToTheSide", // Open preview in split

      // --- File Search ---
      "space f p": "projects::OpenRecent", // LazyVim: <leader>fp
      "space f f": "file_finder::Toggle", // LazyVim: <leader>ff
      "space f r": "pane::ActivatePreviousItem", // LazyVim: <leader>fr (recent)

      // --- Git ---
      // FIX: was space g g → collides with LazyVim <leader>gg = lazygit
      "space g l": "workspace::ToggleLeftDock", // Open Git panel (left dock)
      "space g b": "git::Blame", // LazyVim: <leader>gb
      "space g B": "editor::CopyPermalinkToLine", // LazyVim: <leader>gB
      "space g d": "editor::ExpandAllDiffHunks", // LazyVim: <leader>gd
      "space g h d": "editor::ToggleSelectedDiffHunks",

      // FIX: LazyVim uses ]h/[h for hunks (gitsigns), not ]c/[c
      "] h": "editor::GoToHunk", // LazyVim: ]h
      "[ h": "editor::GoToPreviousHunk", // LazyVim: [h
      // kept as aliases — muscle memory fallback
      "] c": "editor::GoToHunk",
      "[ c": "editor::GoToPreviousHunk",

      // --- Navigation ---
      "g f": "editor::OpenExcerpts", // Open file path under cursor
      "K": "editor::Hover", // LazyVim: K (hover/docs) ✅

      // --- AI ---
      "space a a": "agent::ToggleFocus", // Open AI assistant panel
      "space a i": "assistant::InlineAssist", // Inline AI at cursor
    },
  },

  // ============================================================================
  // NORMAL MODE ONLY BINDINGS
  // ============================================================================
  {
    "context": "Editor && vim_mode == normal && !VimWaiting && !menu",
    "bindings": {
      // --- Pane Navigation (Vim-style) ---
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",

      // --- Window Management ---
      "space w v": "pane::SplitRight", // LazyVim: <leader>| (split right)
      "space w s": "pane::SplitDown", // LazyVim: <leader>- (split below)
      "space w q": "pane::CloseActiveItem", // LazyVim: <leader>wd
      "space w d": "pane::CloseActiveItem", // LazyVim exact: <leader>wd
      "space w o": "workspace::CloseInactiveTabsAndPanes",
      "space w m": "workspace::ToggleZoom", // LazyVim: <leader>wm ✅

      // --- Code Actions ---
      "space c f": "editor::Format", // LazyVim: <leader>cf ✅
      "space c a": "editor::ToggleCodeActions", // LazyVim: <leader>ca ✅
      "space .": "editor::ToggleCodeActions", // quick access alias
      "space c r": "editor::Rename", // LazyVim: <leader>cr ✅

      // --- Go To (LSP) ---
      "g d": "editor::GoToDefinition", // LazyVim: gd ✅
      // FIX: gD in LazyVim = GoToDeclaration, NOT definition split
      "g D": "editor::GoToDeclaration", // LazyVim: gD (declaration) ✅
      "space g D": "editor::GoToDefinitionSplit", // custom: split definition
      "g i": "editor::GoToImplementation", // LazyVim: gI (lowercase fine as custom)
      "g I": "editor::GoToImplementationSplit", // split implementation
      // FIX: LazyVim uses gy for type definition (go to tYpe), NOT gt
      // gt in vanilla vim = next tab — was a silent collision!
      "g y": "editor::GoToTypeDefinition", // LazyVim: gy ✅ FIXED from gt
      "g Y": "editor::GoToTypeDefinitionSplit", // split type definition
      "g r": "editor::FindAllReferences", // LazyVim: gr ✅

      // --- Diagnostics ---
      "] d": "editor::GoToDiagnostic", // LazyVim: ]d ✅
      "[ d": "editor::GoToPreviousDiagnostic", // LazyVim: [d ✅
      "] e": ["editor::GoToDiagnostic", { "severity": "error" }], // LazyVim: ]e ✅
      "[ e": ["editor::GoToPreviousDiagnostic", { "severity": "error" }], // LazyVim: [e ✅
      "space x x": "diagnostics::Deploy", // LazyVim: <leader>xx (Trouble) ✅
      "space c d": "editor::Hover", // Show diagnostic detail at cursor

      // --- Search & Symbols ---
      "space s s": "outline::Toggle", // LazyVim: <leader>ss ✅
      "space s S": "project_symbols::Toggle", // LazyVim: <leader>sS ✅
      "space s h": "command_palette::Toggle", // custom (LazyVim <leader>sh = help tags)
      "space /": "pane::DeploySearch", // LazyVim: <leader>/ ✅
      "space s g": "pane::DeploySearch", // alias for global grep
      "space s r": ["pane::DeploySearch", { "replace_enabled": true }], // LazyVim: <leader>sr

      // --- Buffer Management ---
      "] b": "pane::ActivateNextItem", // LazyVim: ]b ✅
      "[ b": "pane::ActivatePreviousItem", // LazyVim: [b ✅
      "space ,": "pane::ActivatePreviousItem", // quick toggle last file
      "space b b": "tab_switcher::Toggle", // LazyVim: <leader>bb ✅
      "space b d": "pane::CloseActiveItem", // LazyVim: <leader>bd ✅
      "space b o": "pane::CloseOtherItems", // LazyVim: <leader>bo ✅
      // FIX: removed bare "space q" — shadowed entire <leader>q quit/session group
      // LazyVim: <leader>qq = quit all, <leader>ql = restore session
      "space q q": "zed::Quit", // LazyVim: <leader>qq ✅

      // --- Saving ---
      "ctrl-s": "workspace::Save",
      "space f s": "workspace::Save", // LazyVim: <leader>fs
      "space f S": "workspace::SaveAll", // LazyVim: <leader>fS
      "space W": "workspace::SaveAll",

      // --- File Explorer ---
      "space e": "workspace::ToggleRightDock", // Toggle file tree
      "space E": "pane::RevealInProjectPanel", // Locate current file in tree

      // --- Custom ---
      "= =": "editor::SelectAll", // Select entire buffer

      // ── JUMP / SNEAK ────────────────────────────────────────────────────────
      // Two complementary jump styles — both are in vim mode, no helix_mode needed.
      //
      // 1) vim::HelixJumpToWord  ← CONFIRMED in command palette (your screenshot)
      //    Shows 2-char labels on all visible words. Type label to teleport.
      //    This is flash.nvim / hop.nvim equivalent — the labeled jump.
      //    Bound to `g w` matching Helix's amp-jump default.
      //    LazyVim users: this is your `s` (flash) but arguably better UX on `gw`.
      "g w": "vim::HelixJumpToWord",
      //
      // 2) vim::PushSneak — classic vim-sneak (no labels, 2-char positional)
      //    Type `s` + 2 chars → jumps to next occurrence of those chars on screen.
      //    Mirrors LazyVim's flash `s` binding but without the label overlay.
      //    `shift-s` jumps backward. Great for precise char-level targeting.
      "s": "vim::PushSneak",
      "shift-s": "vim::PushSneakBackward",
    },
  },

  // ============================================================================
  // EMPTY PANE BINDINGS (when no files are open)
  // ============================================================================
  {
    "context": "EmptyPane || SharedScreen",
    "bindings": {
      "space space": "file_finder::Toggle",
      "space f f": "file_finder::Toggle",
      "space f p": "projects::OpenRecent",
    },
  },

  // ============================================================================
  // INSERT MODE BINDINGS
  // ============================================================================
  {
    "context": "Editor && vim_mode == insert && !menu",
    "bindings": {
      "j j": "vim::NormalBefore", // exit insert with jj
      "j k": "vim::NormalBefore", // exit insert with jk
    },
  },

  // ============================================================================
  // VIM OPERATOR BINDINGS
  // cr = rename, ca = code actions (Zed-specific trick, no LazyVim equivalent)
  // ============================================================================
  {
    "context": "Editor && vim_operator == c",
    "bindings": {
      "r": "editor::Rename", // `cr` triggers LSP rename
      "a": "editor::ToggleCodeActions", // `ca` triggers code actions
    },
  },

  // ============================================================================
  // WORKSPACE & TERMINAL
  // ============================================================================
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-\\": "terminal_panel::ToggleFocus", // LazyVim: <C-/> terminal toggle
      "space '": "terminal_panel::ToggleFocus", // alternative
      "space t t": "terminal_panel::ToggleFocus", // alternative
      "space t n": "workspace::NewTerminal", // new terminal tab
      "space t T": "workspace::NewCenterTerminal", // terminal as center tab
      "space u t": "theme_selector::Toggle", // theme picker
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      // Jump out of terminal back to editor panes
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
    },
  },

  // ============================================================================
  // PROJECT PANEL BINDINGS (right dock file explorer)
  // ============================================================================
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "a": "project_panel::NewFile",
      "A": "project_panel::NewDirectory",
      "r": "project_panel::Rename",
      "d": "project_panel::Delete",
      "x": "project_panel::Cut",
      "c": "project_panel::Copy",
      "p": "project_panel::Paste",
      "y": "workspace::CopyPath",
      "Y": "workspace::CopyRelativePath",
      "q": "workspace::ToggleRightDock",
      // Navigate back to editor from file tree
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
    },
  },

  // ============================================================================
  // GLOBAL DOCK NAVIGATION
  // Universal jump-out from any dock (Git, AI, Diagnostics, etc.)
  // ============================================================================
  {
    "context": "Dock",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
    },
  },
]
