{
  "tabs": {
    "git_status": false,
  },
  "icon_theme": "Zed (Default)",
  "features": {
    "edit_prediction_provider": "zed",
  },
  "minimap": {
    "show": "auto",
  },
  "autosave": "on_focus_change",
  "ui_font_size": 16,
  "buffer_font_size": 18.0,
  "theme": "Tokyo Night",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "ui_font_family": "JetBrainsMono Nerd Font",
  "relative_line_numbers": "enabled",
  "tab_bar": {
    "show": true,
  },
  "scrollbar": {
    "show": "auto",
  },
  "vim_mode": true,
  "project_panel": {
    "show_diagnostics": "errors",
    "button": true,
    "auto_fold_dirs": true,
    "dock": "right",
    "scrollbar": {
      "show": "auto",
    },
    "auto_reveal_entries": true,
    "folder_icons": true,
    "default_width": 240,
    "git_status": true,
  },
  "indent_guides": {
    "enabled": true,
  },
  "centered_layout": {
    "left_padding": 0.15,
    "right_padding": 0.15,
  },
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "classAttributes": ["class", "className", "ngClass", "styles"],
      },
    },
    "golangci-lint": {
      "initialization_options": {
        "command": [
          "golangci-lint",
          "run",
          "--output.json.path",
          "stdout",
          "--show-stats=false",
          "--output.text.path=",
        ],
      },
    },
  },
  "languages": {
    "TypeScript": {
      "inlay_hints": {
        "enabled": true,
        "show_parameter_hints": false,
        "show_other_hints": true,
        "show_type_hints": true,
      },
      "formatter": "prettier",
    },
    "JSON": {
      "formatter": "prettier",
      "format_on_save": "on",
    },
    "Python": {
      "formatter": { "language_server": { "name": "ruff" } },
      "language_servers": ["pyright", "ruff"],
    },
    "Go": {
      "format_on_save": "on",
      "language_servers": ["gopls", "golangci-lint"],
    },
  },
  "file_types": {
    "Dockerfile": ["Dockerfile", "Dockerfile.*"],
    "JSON": ["json", "jsonc", "*.code-snippets"],
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    // above is default from Zed
    "**/out",
    "**/dist",
    "**/.husky",
    "**/.turbo",
    "**/.vscode-test",
    "**/.vscode",
    "**/.next",
    "**/.storybook",
    "**/.tap",
    "**/.nyc_output",
    "**/report",
    "**/node_modules",
  ],
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "notification_panel": {
    "dock": "left",
  },
}
